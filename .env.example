# Discord OAuth application
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional in local dev; in production use the exact public callback URL
DISCORD_REDIRECT_URI=https://your-domain.example/api/auth/callback

# Public origin used for OAuth redirects behind a proxy
DOMINYX_PUBLIC_URL=https://your-domain.example

# Random 32+ character server-only session secret
DOMINYX_SESSION_SECRET=

# Railway bot-management API adapter
RAILWAY_BOT_API_URL=https://your-railway-service.example
RAILWAY_BOT_API_KEY=

# Runtime
PORT=3000
NODE_ENV=production
