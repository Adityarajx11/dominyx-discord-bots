# Discord OAuth application
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must match the redirect URI registered in the Discord Developer Portal exactly
DISCORD_REDIRECT_URI=https://your-domain.example/api/auth/callback

# Public origin used for OAuth redirects behind a proxy
AUREX_PUBLIC_URL=https://your-domain.example

# Random 32+ character server-only session secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUREX_SESSION_SECRET=

# Shared Postgres used by the dashboard and all six bots
DATABASE_URL=postgres://user:password@host:5432/aurex

# General bot token, used for guild/channel/role reads
BOT_TOKEN=

# Per-module bot tokens. Used to detect which modules are installed in a server.
BOT_TOKEN_MUSIC=
BOT_TOKEN_LEVEL=
BOT_TOKEN_GREET=
BOT_TOKEN_TICKET=
BOT_TOKEN_PING=
BOT_TOKEN_GUARD=

# Application (client) IDs, used to build "Add to Discord" invite links
BOT_ID_MUSIC=
BOT_ID_LEVEL=
BOT_ID_GREET=
BOT_ID_TICKET=
BOT_ID_PING=
BOT_ID_GUARD=

# Runtime
PORT=3000
NODE_ENV=production
# Postgres pool size. Keep at 1 on serverless hosts like Vercel.
PG_POOL_MAX=1
